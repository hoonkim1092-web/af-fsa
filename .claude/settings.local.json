{
  "permissions": {
    "allow": [
      "Read(//d D:/hoonProJect/worktrees/**)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python -c:*)",
      "Bash(git:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(timeout:*)",
      "Bash(sed:*)",
      "Bash(for:*)",
      "Bash(while:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(af:*)",
      "Bash(dist/af/af.exe:*)",
      "Bash(D:/hoonProJect/worktrees/agent-factory/dist/af/af.exe:*)",
      "Bash(powershell:*)",
      "Bash(cmd:*)",
      "Bash(where:*)",
      "Bash(tasklist:*)",
      "Bash(taskkill:*)",
      "Bash(reg query:*)",
      "Bash(cp:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:aisparkup.com)",
      "WebFetch(domain:bkamp.ai)",
      "Bash(codex --version)",
      "Bash(codex --help)",
      "Bash(codex review:*)",
      "Bash(codex exec:*)",
      "Bash(codex mcp-server:*)",
      "Bash(claude mcp:*)",
      "Bash(claude plugin:*)",
      "Bash(cat D:/hoonProJect/worktrees/agent-factory/.af_review_queue/pending/*.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python -m py_compile \"$fp\" 2>&1 || echo \"[af-hook] syntax error in $fp\" ;; esac",
            "timeout": 10,
            "statusMessage": "Python syntax check..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python scripts/code_review_updater.py --no-llm 2>/dev/null ;; esac",
            "timeout": 15,
            "statusMessage": "Code review log update..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; python scripts/design_review_trigger.py \"$fp\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Design review check..."
          },
          {
            "type": "command",
            "command": "for f in .af_review_queue/notifications/*.txt; do [ -f \"$f\" ] && cat \"$f\" && rm -f \"$f\"; done 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
