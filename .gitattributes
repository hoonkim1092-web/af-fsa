# Default text normalization for common source and document files.
*.md   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.txt  text eol=lf
*.sql  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.sh   text eol=lf
# Windows-native script files should keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
dist/*.zip filter=lfs diff=lfs merge=lfs -text
